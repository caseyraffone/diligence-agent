# ---------------------------------------------------------------------------
# Credential Integrity Agent — example environment.
# Copy to `.env` and fill in:  cp .env.example .env
#
# NOTHING IN THIS FILE IS A REAL SECRET. Never commit a populated `.env`.
#
# The defaults below run the entire application — seeding, reviewer dashboard,
# applicant portal, verification workflow, reports, and the full test suite —
# with NO API KEYS AND NO API COSTS.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"
APP_BASE_URL="http://localhost:3200"

# --- Database --------------------------------------------------------------
# Docker path:     docker compose up -d db   (see docker-compose.yml)
# Non-Docker path: see README "PostgreSQL without Docker"
DATABASE_URL="postgresql://cia:cia_local_dev@127.0.0.1:5432/cia_dev?schema=public"
# Used only by `npm test`. MUST be a throwaway database: the suite truncates it.
TEST_DATABASE_URL="postgresql://cia:cia_local_dev@127.0.0.1:5432/cia_test?schema=public"

# --- Cryptography ----------------------------------------------------------
# Generate: openssl rand -base64 48
# Signs session cookies, CSRF tokens, applicant portal tokens, upload grants.
APP_SECRET="dev-only-change-me-openssl-rand-base64-48-xxxxxxxxxxxx"
# Encrypts stored document bytes at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY="dev-only-change-me-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# LLM PROVIDER
# ---------------------------------------------------------------------------
# mock | openai | anthropic | ollama
#
#   mock      deterministic, offline, free. THE DEFAULT. Used by dev, seed
#             demonstrations, and CI. Returns realistic structured results so
#             the whole product can be demonstrated without spending money.
#   openai    PAID. Billed per request.
#   anthropic PAID. Billed per request.
#   ollama    free, local. Requires a running Ollama daemon.
#
# The app NEVER falls back from mock to a paid provider, and never makes a paid
# request unless you explicitly set LLM_PROVIDER to that provider AND supply its
# key. Selecting a paid provider without its key fails startup loudly.
LLM_PROVIDER="mock"

# Shared guardrails, applied to every provider.
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="2"
LLM_MAX_OUTPUT_TOKENS="4096"
# Prompts contain applicant data. Leave false outside deliberate debugging.
LLM_LOG_PROMPTS="false"

# Read only when LLM_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Read only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Read only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

# --- Document processing ---------------------------------------------------
# Comma-separated chain; first processor matching the mime type wins.
DOCUMENT_PROCESSORS="text,pdf,mock-ocr"

# --- Object storage --------------------------------------------------------
# local | s3   (the s3 driver is a documented interface stub; see README)
OBJECT_STORE_DRIVER="local"
OBJECT_STORE_LOCAL_PATH="./storage"

# --- Malware scanning ------------------------------------------------------
# noop | clamav-http
# `noop` marks uploads UNSUPPORTED, never CLEAN. It is not a scanner.
MALWARE_SCANNER="noop"
CLAMAV_HTTP_URL=""

# --- External source adapters ----------------------------------------------
# false (default) => every adapter serves recorded fixtures; zero network calls.
# true            => only the open, no-agreement-required adapters go live
#                    (Crossref, PubMed). Everything else stays on fixtures.
# Tests force this off regardless of what is set here.
ENABLE_LIVE_SOURCES="false"
# Crossref and PubMed require an identifying contact in the User-Agent as a
# condition of their access policies. Required when ENABLE_LIVE_SOURCES=true.
LIVE_SOURCE_CONTACT_EMAIL=""
LIVE_SOURCE_CACHE_TTL_SECONDS="86400"

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES="26214400"          # 25 MiB
LOGIN_RATE_LIMIT_PER_15MIN="10"
TIP_RATE_LIMIT_PER_HOUR="5"
